# --- Monday API (existing) ---------------------------------------------------
# Server-side only. Never expose with a NEXT_PUBLIC_ prefix.
MONDAY_API_TOKEN=
MONDAY_API_URL=https://api.monday.com/v2

# --- Teacher Portal authentication --------------------------------------------
# cloudflare = read identity from Cloudflare Access headers (production)
# preview    = simulated identity for local development / demos
# Default: preview when MONDAY_API_TOKEN is empty, cloudflare otherwise.
AUTH_MODE=

# Preview identity (preview mode only). See lib/monday/portal-mock.ts for the
# available mock users (yael@example.com, amir@example.com=mentor,
# manager@example.com=training_manager, admin@example.com=admin,
# pending@example.com, blocked@example.com, duplicate@example.com).
PORTAL_PREVIEW_EMAIL=

# Role allowlists until a Monday "app role" column is mapped (comma-separated).
PORTAL_ADMIN_EMAILS=
PORTAL_TRAINING_MANAGER_EMAILS=

# --- Teacher Portal Monday mappings -------------------------------------------
# Meetings board (every lesson is a real Monday item). Required for real-mode
# meetings/attendance/calendar. Column IDs live in lib/monday/portal-mappings.ts.
PORTAL_MEETINGS_BOARD_ID=

# Optional materials/links board. Local typed fallback is used when empty.
PORTAL_MATERIALS_BOARD_ID=

# Optional production hardening: validate Cf-Access-Jwt-Assertion audience.
CLOUDFLARE_ACCESS_AUD=
